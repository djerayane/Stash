{
  "name": "@stash/server",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present build && pnpm run build:server",
    "build:shared": "pnpm --filter @stash/sync... --filter @stash/rich-text... build",
    "build:web": "pnpm --filter @stash/web build",
    "build:server": "tsc -p tsconfig.build.json",
    "check": "pnpm run check:server && pnpm --recursive --if-present check",
    "check:server": "tsc --noEmit",
    "start": "node dist/main.js",
    "pretest": "pnpm run build:shared",
    "test": "pnpm run test:server && pnpm --recursive --if-present test",
    "pretest:unit": "pnpm run build:shared",
    "test:unit": "pnpm --filter @stash/web exec vitest run --exclude '**/*.integration.test.*'",
    "pretest:integration": "pnpm run build:shared",
    "test:integration": "pnpm --filter @stash/web run test:integration",
    "pretest:browser": "pnpm run build:shared",
    "test:browser": "pnpm run build:web && playwright test --grep-invert @a11y",
    "pretest:a11y": "pnpm run build:shared",
    "test:a11y": "pnpm run build:web && playwright test --grep @a11y",
    "test:stable-release": "node --import tsx --test tests/stable-release-journey.test.ts",
    "benchmark:stable-release": "node --import tsx scripts/benchmark-stable-release.ts",
    "test:server": "node --import tsx --test tests/**/*.test.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "backup": "node --import tsx src/backup-command.ts",
    "migrate:embedded": "node --import tsx src/migrate-embedded-command.ts",
    "package:server": "pnpm run build && node scripts/prepare-server-deploy.mjs && pnpm --config.node-linker=hoisted --filter @stash/server deploy --prod --legacy .bundle-deploy && node scripts/package-server.mjs",
    "smoke:server-bundle": "node scripts/smoke-server-bundle.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@electric-sql/pglite": "^0.5.7",
    "@simplewebauthn/server": "^13.3.2",
    "@stash/domain-types": "workspace:*",
    "@stash/rich-text": "workspace:*",
    "@stash/sync": "workspace:*",
    "@stash/validation": "workspace:*",
    "nodemailer": "^9.0.5",
    "pg": "^8.16.3",
    "prosemirror-model": "^1.25.11",
    "redis": "^5.12.1",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
